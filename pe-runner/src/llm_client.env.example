# ============================================================
# LLM API 配置模板
# ============================================================
# 使用步骤：
#   1. 复制本文件为同目录下的 .env（即 src/.env）
#   2. 将下面的占位符替换为你自己的真实值
#   3. .env 已被 .gitignore 忽略，不会被提交
# ------------------------------------------------------------

# ===== 必需配置 =====

# 主 API Key（必填）
API_KEY="your_api_key_here"

# API Endpoint Base URL（必填，OpenAI 兼容接口）
# 例如 OpenAI 官方：https://api.openai.com/v1
# 或任意兼容服务的 Base URL
BASE_URL="https://api.openai.com/v1"

# 模型名称（必填，从 env 读取，避免硬编码）
# 例如：gpt-4o / gpt-4o-mini / 你的部署名
MODEL_NAME="gpt-4o-mini"


# ===== 可选配置（多 Key 轮换）=====
# 配置后遇限流(429)或超时会自动切换到下一个 Key
# API_KEY_FALLBACK_1="your_backup_key_1"
# API_KEY_FALLBACK_2="your_backup_key_2"


# ===== 可选配置（运行参数，留空使用默认值）=====
# 单次请求最大 tokens
# MAX_TOKENS=16384

# HTTP 超时秒数
# HTTP_TIMEOUT=300

# 限流/超时最大重试次数
# LLM_RETRIES=5

# 指数退避：基础等待秒数（实际等待 = base * 2^attempt）
# LLM_RETRY_BASE_SLEEP=1.0

# 指数退避：单次等待上限
# LLM_RETRY_MAX_SLEEP=30.0
